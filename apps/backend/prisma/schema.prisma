generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Interview {
  id             String            @id @default(uuid())
  githubMetadata Json
  resumeData     Json
  jdFeedback     Json?
  status         InterviewStatus
  score          Int               @default(0)
  conversations  Message[]
}

model Message {
  id            String        @id @default(uuid())
  message       String
  type          MessageType
  interviewId   String
  interview     Interview     @relation(fields: [interviewId], references: [id])
}

enum MessageType {
  User
  Assistant
}

enum InterviewStatus {
  pre
  InProgress
  Done
}
