// Cloudflare Workers static assets: serves the built frontend. The build
// command (bun install && bun run build) runs first; `wrangler deploy` then
// uploads apps/frontend/dist. Unknown paths such as /result/<id> get
// index.html so the React router can handle them.
{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "interview-agent-local",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/frontend/dist",
    "not_found_handling": "single-page-application"
  }
}
