# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string. URL-encode special characters in the password (@ -> %40).
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/interviewer"

# Optional Google AI Studio key. Leave it empty on a public deployment: each user
# then enters their own key in the browser, which sends it with every request.
# The server uses it for that request only and never stores it. When this is
# set, users may still bring their own key; otherwise this one is used.
GEMINI_API_KEY=""

# Optional: the Gemini Live model used for the voice interview.
GEMINI_LIVE_MODEL="gemini-3.1-flash-live-preview"

# Optional: models for resume extraction, job fit, and scoring. The fallback is
# used when the primary is rate-limited or overloaded.
GEMINI_TEXT_MODEL="gemini-3.5-flash-lite"
GEMINI_TEXT_FALLBACK_MODEL="gemini-3.1-flash-lite"

# Optional: raises GitHub's API limit from 60 to 5,000 requests per hour.
GITHUB_TOKEN=""

# Origins allowed by CORS, comma-separated (for example your Pages URL and a
# custom domain). Defaults to http://localhost:3000.
FRONTEND_URL="http://localhost:3000"

# Port to listen on. Hosts like Railway and Render set this for you.
PORT=3001

# Set this only when your network requires an HTTPS proxy to reach GitHub and Gemini.
PROXY_URL=""
